{
  "name": "mirrorcraft",
  "version": "1.0.0",
  "private": true,
  "description": "MirrorCraft — AI-assisted website reconstruction: extract design tokens, assets and specs from permitted sites, rebuild pixel-faithful Next.js codebases in parallel with AI agents.",
  "author": "mohd012z",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohd012z/MirrorCraft.git"
  },
  "homepage": "https://github.com/mohd012z/MirrorCraft",
  "bugs": {
    "url": "https://github.com/mohd012z/MirrorCraft/issues"
  },
  "keywords": [
    "mirrorcraft",
    "website-reconstruction",
    "visual-analysis",
    "cursor",
    "claude-code",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui",
    "pixel-comparison"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "clone:url": "node scripts/clone-url-runtime.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:agents": "node scripts/sync-agent-rules.mjs",
    "smoke:example": "node scripts/smoke-clone-example.mjs",
    "smoke:crypto": "node scripts/smoke-crypto.mjs",
    "smoke:integrations": "node scripts/smoke-integration-boundary.mjs && node scripts/smoke-integration-connections.mjs",
    "smoke:restrictions": "node scripts/smoke-restrictions.mjs && node scripts/smoke-ai-restrictions.mjs",
    "smoke:adversarial": "node scripts/smoke-adversarial-context.mjs",
    "smoke:providers": "node scripts/smoke-provider-adapters.mjs && node scripts/smoke-zero-cost-hosting.mjs && node scripts/smoke-provider-deployment.mjs && npm run smoke:restrictions && node scripts/smoke-policy-revision.mjs && node scripts/smoke-policy-attestation.mjs",
    "smoke:editing-plan": "node scripts/smoke-editing-plan-contracts.mjs",
    "smoke:publish": "node scripts/smoke-studio-publish.mjs",
    "smoke:runtime": "node scripts/smoke-runtime-classifier.mjs",
    "smoke:domain": "node scripts/smoke-domain-planner.mjs",
    "smoke:lifecycle": "node scripts/smoke-lifecycle.mjs && node scripts/smoke-adversarial-release.mjs",
    "smoke:studio": "node scripts/smoke-studio-playwright.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.62.1",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
